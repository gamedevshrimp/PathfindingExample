local grid = require "main.modules.grid"
local navigation = require "main.modules.navigation"

local GOAL = "goal"
go.property("move_speed", 4)

local function setup_astar()
	astar.setup(
		grid.COLUMNS,
		grid.ROWS,
		astar.DIRECTION_EIGHT,
		grid.COLUMNS * grid.ROWS,
		8,
		true, -- Cash paths
		false, -- Index from 1
		false -- no flip the map
	)

	astar.set_costs({
		[0] = {
			1.0, -- east
			1.0, -- north
			1.0, -- west
			1.0, -- south

			1.4142, -- north-east
			1.4142, -- north-west
			1.4142, -- south-west
			1.4142 -- suth-east
		}
	})
end

local function find_path(self)
	self.has_path = false
	self.path = {}
	self.path_index = 1
	
	local start_position = go.get_position()
	local start_cell = grid.world_to_cell(start_position)
	local goal_position = go.get_position(GOAL)
	self.goal_cell = grid.world_to_cell(goal_position)

	if not start_cell or not self.goal_cell then
		return
	end

	if not start_cell.x or not self.goal_cell.x then
		print("ERROR: Start or goal outside navigation map!")
		return false
	end

	local start_index = grid.get_index(
		start_cell.x,
		start_cell.z
	)

	local goal_index = grid.get_index(self.goal_cell.x, self.goal_cell.z)

	if self.scan.cells[start_index] ~= 0 then
		print("ERROR: Agent starts inside an obstacle!")

		return false
	end

	if self.scan.cells[goal_index] ~= 0 then
		print("ERROR: Goal is blocked!")

		return false
	end

	print("Searching path:" .. start_cell.x .. start_cell.z .. "->" .. self.goal_cell.x .. self.goal_cell.z)
	local status, size, total_cost, path = astar.solve(start_cell.x, start_cell.z, self.goal_cell.x, self.goal_cell.z)

	if status == astar.SOLVED then
		print("PATH FOUND!")
		self.path = {}

		for i, tile in ipairs(path) do
			local position = grid.cell_to_world(tile.x, tile.y)
			position.y = start_position.y
			self.path[i] = position
		end

		self.path_index = 1
		self.has_path = true
		return true
	elseif status == astar.NO_SOLUTION then
		print("NO PATH FOUND!")
		return false
	elseif status == astar.START_END_SAME then
		print("Agent is already at destination!")
		return false
	end

	print("Unknown A* status:", status)
	return false
end


local function check_goal_position(self)
	local goal_position = go.get_position(GOAL)
	local goal_cell = grid.world_to_cell(goal_position)
	if not self.goal_cell
		or not goal_cell
		or self.goal_cell.x ~= goal_cell.x
		or self.goal_cell.z ~= goal_cell.z then
		self.goal_cell = goal_cell
		find_path(self)
	end
end

local function draw_path(self)
	if not self.path or #self.path < 2 then
		return
	end

	for index = 1, #self.path - 1 do
		msg.post("@render:", "draw_line", {
			start_point = self.path[index],
			end_point = self.path[index + 1],
			color = vmath.vector4(1, 0, 0, 1)
		})
	end
end

local function move_agent(self, dt)
	if self.path_index > #self.path then
		self.has_path = false
		print("DESTINATION REACHED!")
		return
	end

	local position = go.get_position()
	local target = self.path[self.path_index]
	local direction = target - position
	local distance = vmath.length(direction)

	local step = self.move_speed * dt

	if distance <= step then
		go.set_position(target)
		self.path_index = self.path_index + 1
		check_goal_position(self)
	else
		direction = direction / distance
		position = position + direction * step

		go.set_position(position)
	end
end

function init(self)
	assert(astar ~= nil, "A* extension is not loaded!")
	setup_astar()
	self.scan = navigation.begin_scan()
	self.map_ready = false
	self.has_path = false
	self.path = {}
	self.path_index = 1

	print("Navigation scanning started!")
end

function update(self, dt)
	-- Build the map
	if not self.map_ready then
		local finished = navigation.scan_step(self.scan)

		if finished then
			print("Navigation map is ready!")
			astar.set_map(self.scan.cells)
			-- astar.print_map()
			self.map_ready = true
			find_path(self)
		end
		return
	end

	-- Move the agent
	if self.has_path then
		move_agent(self, dt)
		draw_path(self)
	end
end

function final(self)
	astar.reset()
end
