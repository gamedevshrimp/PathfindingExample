local POINTS = {
	vmath.vector3(45, 0, 45),
	vmath.vector3(5, 0, 45),
	vmath.vector3(5, 0, 5),
	vmath.vector3(45, 0, 5),
}
local DURATION = 5

local function move_to_next(self)
	self.point_index = self.point_index % #POINTS + 1
	go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, POINTS[self.point_index],
		go.EASING_LINEAR, DURATION, 0, move_to_next)
end

function init(self)
	self.point_index = 0
	move_to_next(self)
end