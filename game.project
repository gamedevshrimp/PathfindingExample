[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 960
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
type = 3D
debug = 0
use_fixed_timestep = 0

[html5]
scale_mode = no_scale

[project]
title = PathfindingExample
dependencies#0 = https://github.com/selimanac/defold-astar/archive/refs/tags/v1.2.3.zip

